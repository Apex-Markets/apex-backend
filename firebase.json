{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
   "rewrites": [
  { "source": "/oauth/callback/schwab/**", "function": "schwabOAuthCallback" },
  { "source": "/firebase-web-authn-api/**", "function": "ext-firebase-web-authn-api" },
  { "source": "/sign-in", "destination": "/sign-in.html" },
  { "source": "/sign-up", "destination": "/sign-up.html" },
  { "source": "/apex-tool", "destination": "/apex-tool.html" },
  { "source": "/privacy-policy", "destination": "/privacy-policy.html" },  
  { "source": "/privacy", "destination": "/privacy.html" },
  { "source": "/terms", "destination": "/terms.html" },
  { "source": "/what-we-offer", "destination": "/what-we-offer.html" },
  { "source": "/", "destination": "/index.html" }
]
  },
"functions": { "source": "functions", "runtime": "nodejs20" },
  "emulators": {
    "functions": { "port": 5004 },
    "hosting": { 
      "host": "127.0.0.1", 
      "port": 5007,
      "serveBundledAssets": true  
    },
    "ui": { "enabled": true, "port": 4004 },       
    "hub": { "port": 4403 },             
    "firestore": { "port": 8081 }, 
    "auth": { "port": 9100 },
    "storage": { "port": 9199 },
    "database": { "port": 9000 },
    "pubsub": { "port": 8085 },
    "singleProjectMode": true
  },
  "storage": { "rules": "storage.rules" }
}